<script>
(function () {
  function paintSwatch(el, opts) {
    var c = document.createElement('canvas');
    var w = 480, h = 480;
    c.width = w; c.height = h;
    c.style.width = '100%';
    c.style.height = '100%';
    c.style.display = 'block';
    var ctx = c.getContext('2d');

    var g = ctx.createLinearGradient(0, 0, w, h);
    opts.base.forEach(function (stop) { g.addColorStop(stop[0], stop[1]); });
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, w, h);

    var seed = opts.seed || 1;
    function rand() {
      seed = (seed * 9301 + 49297) % 233280;
      return seed / 233280;
    }
    for (var i = 0; i < opts.speckle; i++) {
      var x = rand() * w, y = rand() * h;
      var r = rand() * opts.speckleSize + 0.4;
      ctx.beginPath();
      ctx.fillStyle = opts.speckleColor[Math.floor(rand() * opts.speckleColor.length)];
      ctx.globalAlpha = 0.10 + rand() * 0.22;
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    if (opts.veins) {
      for (var v = 0; v < opts.veins; v++) {
        ctx.beginPath();
        ctx.strokeStyle = opts.veinColor;
        ctx.lineWidth = 0.6 + rand() * 1.8;
        ctx.globalAlpha = 0.16 + rand() * 0.18;
        var sx = rand() * w, sy = rand() * h;
        ctx.moveTo(sx, sy);
        var px = sx, py = sy;
        for (var s = 0; s < 5; s++) {
          var nx = px + (rand() - 0.35) * (w / 3);
          var ny = py + (rand() - 0.2) * (h / 3);
          ctx.quadraticCurveTo(px + (nx - px) / 2, py + (rand() - 0.5) * 40, nx, ny);
          px = nx; py = ny;
        }
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }

    el.innerHTML = '';
    el.appendChild(c);
  }

  var palettes = {
    facade: {
      base: [[0, '#d7d0bd'], [1, '#b7ac93']],
      speckle: 900, speckleSize: 1.6,
      speckleColor: ['#8f8468', '#efe9d8', '#a59a7d'],
      veins: 3, veinColor: '#5c5540', seed: 7
    },
    interior: {
      base: [[0, '#efe8da'], [1, '#d8cdb6']],
      speckle: 500, speckleSize: 1.2,
      speckleColor: ['#b7a077', '#fffaf0'],
      veins: 6, veinColor: '#a97c4f', seed: 21
    },
    limestone: {
      base: [[0, '#e9e3d2'], [1, '#d3cab0']],
      speckle: 700, speckleSize: 1.4,
      speckleColor: ['#a89a79', '#f5efdf'],
      veins: 2, veinColor: '#8c7d5c', seed: 3
    },
    travertine: {
      base: [[0, '#e7cfa9'], [1, '#c9a06c']],
      speckle: 1100, speckleSize: 1.8,
      speckleColor: ['#a5794a', '#f2dfba'],
      veins: 4, veinColor: '#8a5a30', seed: 11
    },
    granite: {
      base: [[0, '#4a473f'], [1, '#26241f']],
      speckle: 1400, speckleSize: 1.6,
      speckleColor: ['#c9c2ac', '#8f866c', '#050403'],
      veins: 0, veinColor: '#000', seed: 42
    },
    marble: {
      base: [[0, '#f4f1e8'], [1, '#e2ddcd']],
      speckle: 200, speckleSize: 1,
      speckleColor: ['#cfc7ac'],
      veins: 9, veinColor: '#a97c4f', seed: 5
    }
  };

  document.querySelectorAll('[data-swatch]').forEach(function (el) {
    var key = el.getAttribute('data-swatch');
    if (palettes[key]) paintSwatch(el, palettes[key]);
  });

  // ---- ambient hero backdrop: Taj Mahal marble ----
  var canvas = document.getElementById('vein-canvas');
  var ctx = canvas.getContext('2d');
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function resize() {
    var rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  }

  function draw() {
    var rect = canvas.parentElement.getBoundingClientRect();
    var w = rect.width, h = rect.height;
    ctx.clearRect(0, 0, w, h);

    var seed = 19;
    function rand() {
      seed = (seed * 9301 + 49297) % 233280;
      return seed / 233280;
    }

    // soft ivory base
    var base = ctx.createLinearGradient(0, 0, w, h);
    base.addColorStop(0, '#f8f3e6');
    base.addColorStop(0.45, '#f2ead4');
    base.addColorStop(1, '#e9dfc4');
    ctx.fillStyle = base;
    ctx.fillRect(0, 0, w, h);

    // cloudy warm patches for depth
    for (var p = 0; p < 16; p++) {
      var px0 = rand() * w, py0 = rand() * h;
      var r = 90 + rand() * (w * 0.22);
      var rg = ctx.createRadialGradient(px0, py0, 0, px0, py0, r);
      rg.addColorStop(0, 'rgba(199,169,113,0.16)');
      rg.addColorStop(1, 'rgba(199,169,113,0)');
      ctx.fillStyle = rg;
      ctx.beginPath();
      ctx.arc(px0, py0, r, 0, Math.PI * 2);
      ctx.fill();
    }

    // long flowing linear veins, Taj Mahal signature
    var veinColors = ['#b08c54', '#c7a670', '#9b7844', '#d8bd8b'];
    for (var v = 0; v < 10; v++) {
      ctx.beginPath();
      ctx.strokeStyle = veinColors[v % veinColors.length];
      ctx.lineWidth = 0.7 + rand() * 2.4;
      ctx.globalAlpha = 0.12 + rand() * 0.16;
      var sy = rand() * h * 1.1 - h * 0.05;
      var px = -40, py = sy;
      ctx.moveTo(px, py);
      var steps = 6;
      for (var s = 0; s < steps; s++) {
        var nx = px + (w + 80) / steps;
        var ny = py + (rand() - 0.5) * h * 0.3;
        ctx.quadraticCurveTo(px + (nx - px) / 2, py + (rand() - 0.5) * 70, nx, ny);
        px = nx; py = ny;
      }
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    // fine crystalline speckle
    for (var i = 0; i < 260; i++) {
      var x = rand() * w, y = rand() * h;
      ctx.beginPath();
      ctx.fillStyle = rand() > 0.5 ? 'rgba(255,255,255,0.4)' : 'rgba(150,118,72,0.14)';
      ctx.globalAlpha = 0.4 + rand() * 0.3;
      ctx.arc(x, y, rand() * 1.3 + 0.3, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  window.addEventListener('resize', resize);
  resize();


  // ---- mobile hamburger menu ----
  var navToggle = document.querySelector('.nav-toggle');
  var navLinksEl = document.getElementById('nav-links');
  if (navToggle && navLinksEl) {
    navToggle.addEventListener('click', function () {
      var isOpen = navLinksEl.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    navLinksEl.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        navLinksEl.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 640) {
        navLinksEl.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // ---- nav flips to dark bg / beige logo over dark sections (e.g. Projekti) ----
  var navEl = document.querySelector('.nav');
  var darkSections = document.querySelectorAll('[data-nav-theme="dark"]');
  if (navEl && darkSections.length && 'IntersectionObserver' in window) {
    var navH = navEl.offsetHeight || 76;
    var toggle = function () {
      var anyDark = Array.prototype.some.call(darkSections, function (s) {
        var r = s.getBoundingClientRect();
        return r.top <= navH && r.bottom >= navH;
      });
      navEl.classList.toggle('nav--dark', anyDark);
    };
    var obs = new IntersectionObserver(toggle, { rootMargin: '-' + navH + 'px 0px -' + navH + 'px 0px', threshold: 0 });
    darkSections.forEach(function (s) { obs.observe(s); });
    window.addEventListener('resize', toggle);
    toggle();
  }

  // ---- Vrste kamena: "Prikaži sve" / "Prikaži manje" toggle per category ----
  document.querySelectorAll('.stone-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var grid = document.getElementById(btn.getAttribute('data-target'));
      if (!grid) return;
      var expanded = grid.classList.toggle('expanded');
      btn.textContent = expanded ? btn.getAttribute('data-label-less') : btn.getAttribute('data-label-more');
      if (!expanded) {
        grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });

  // ---- Zavrseni projekti: vodoravna traka svih vrsta kamena (popis ostaje skriven izvor podataka) ----
  (function () {
    var items = [];
    document.querySelectorAll('.zp-name').forEach(function (nameEl) {
      var summary = nameEl.closest('summary');
      if (!summary) return;
      var countEl = summary.querySelector('.zp-count');
      if (!countEl || !/fotografija/.test(countEl.textContent)) return;
      var details = summary.parentElement;
      var grid = details.querySelector('.zp-grid');
      if (!grid) return;
      var img = grid.querySelector('.gallery-item img');
      if (!img) return;
      items.push({ name: nameEl.textContent, gridId: grid.id, src: img.getAttribute('src') });
    });
    if (!items.length) return;

    var stripEl = document.getElementById('zp-strip');
    var prevBtn = document.getElementById('zp-strip-prev');
    var nextBtn = document.getElementById('zp-strip-next');
    if (!stripEl || !prevBtn || !nextBtn) return;

    items.forEach(function (it, i) {
      var tile = document.createElement('a');
      tile.href = '#';
      tile.className = 'zp-strip-tile';
      tile.setAttribute('data-idx', i);
      tile.innerHTML =
        '<span class="zp-strip-cover"><img src="' + it.src + '" alt="' + it.name + '" loading="lazy"></span>' +
        '<span class="zp-strip-name">' + it.name + '</span>';
      tile.addEventListener('click', function (e) {
        e.preventDefault();
        if (typeof openStoneGallery === 'function') {
          openStoneGallery(it.gridId, 0);
        }
      });
      stripEl.appendChild(tile);
    });

    function tileStep() {
      var tile = stripEl.querySelector('.zp-strip-tile');
      if (!tile) return 144;
      var style = window.getComputedStyle(stripEl);
      var gap = parseFloat(style.columnGap || style.gap || '16') || 16;
      return tile.getBoundingClientRect().width + gap;
    }

    function atStart() { return stripEl.scrollLeft <= 2; }
    function atEnd() { return stripEl.scrollLeft + stripEl.clientWidth >= stripEl.scrollWidth - 2; }

    prevBtn.addEventListener('click', function () {
      if (atStart()) {
        stripEl.scrollTo({ left: stripEl.scrollWidth, behavior: 'smooth' });
      } else {
        stripEl.scrollBy({ left: -tileStep() * 3, behavior: 'smooth' });
      }
    });
    nextBtn.addEventListener('click', function () {
      if (atEnd()) {
        stripEl.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        stripEl.scrollBy({ left: tileStep() * 3, behavior: 'smooth' });
      }
    });
  })();

