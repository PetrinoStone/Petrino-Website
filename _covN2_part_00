<style>
  :root {
    --espresso:   #201e1a;
    --espresso-2: #2b2823;
    --sand:       #faf6ec;
    --sand-raise: #fffdf8;
    --sand-deep:  #f0e9d8;
    --ink:        #322f28;
    --ink-muted:  #7c7566;
    --cream:      #f6f1e4;
    --cream-muted:#c2b8a2;
    --terra:      #bb9862;
    --terra-2:    #a07f4b;
    --terra-soft: #d8bf90;
    --line-dark:  rgba(50,47,40,0.13);
    --line-light: rgba(246,241,228,0.18);

    --bg:        var(--sand);
    --bg-raise:  var(--sand-raise);
    --bg-deep:   var(--sand-deep);
    --fg:        var(--ink);
    --fg-muted:  var(--ink-muted);
    --hairline:  var(--line-dark);
    --accent:    var(--terra);
    --accent-fg: #fbf7ef;

    --dark-bg:      var(--espresso);
    --dark-bg-2:    var(--espresso-2);
    --dark-fg:      var(--cream);
    --dark-fg-muted:var(--cream-muted);
    --dark-line:    var(--line-light);
    --dark-accent:  var(--terra-soft);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg:        var(--dark-bg);
      --bg-raise:  var(--dark-bg-2);
      --bg-deep:   #171715;
      --fg:        var(--dark-fg);
      --fg-muted:  var(--dark-fg-muted);
      --hairline:  var(--dark-line);
      --accent:    var(--dark-accent);
      --accent-fg: #1c1c1a;
    }
  }
  :root[data-theme="dark"] {
    --bg:        var(--dark-bg);
    --bg-raise:  var(--dark-bg-2);
    --bg-deep:   #191510;
    --fg:        var(--dark-fg);
    --fg-muted:  var(--dark-fg-muted);
    --hairline:  var(--dark-line);
    --accent:    var(--dark-accent);
    --accent-fg: #201a12;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; font-size: 15px; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: "Work Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  /* Site-wide marble veining: a subtle multi-color vein pattern layered
     into every section's own background (light sections get the darker
     -toned pattern, permanently-dark sections get the lighter one), so it
     reads like real stone veining without touching text contrast. */
  :root {
    --veins-light: url("data:image/svg+xml;base64,");
    --veins-dark: url("data:image/svg+xml;base64,");
    --veins-svg: var(--veins-light);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --veins-svg: var(--veins-dark); }
  }
  :root[data-theme="dark"] { --veins-svg: var(--veins-dark); }

  h1, h2, h3 {
    font-family: "Bodoni Moda", Georgia, serif;
    font-weight: 600;
    line-height: 1.12;
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.01em;
  }

  .mono {
    font-family: "Work Sans", system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .eyebrow {
    font-family: "Work Sans", system-ui, sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent);
  }

  a { color: inherit; }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: clamp(20px, 5vw, 64px);
    padding-right: clamp(20px, 5vw, 64px);
  }

  /* ---------- NAV ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .nav.nav--dark {
    background: color-mix(in srgb, var(--espresso) 92%, transparent);
    border-bottom-color: var(--line-light);
  }
  .nav.nav--dark .nav-mark { color: var(--cream); }
  .nav.nav--dark .nav-links a:not(.nav-cta) { color: var(--cream-muted); }
  .nav.nav--dark .nav-links a:not(.nav-cta):hover { color: var(--cream); }
  .nav .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }
  .nav-mark {
    font-family: "Bodoni Moda", Georgia, serif;
    font-weight: 800;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1.2rem;
    color: var(--fg);
    transition: color 0.25s ease;
  }
  .nav-links { display: flex; gap: 30px; align-items: center; }
  .nav-links a {
    text-decoration: none;
    font-size: 0.86rem;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }
  .nav-links a:hover, .nav-links a:focus-visible { color: var(--fg); }
  .nav-cta {
    background: #17150f !important;
    color: #faf6ec !important;
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 0.8rem !important;
    letter-spacing: 0.03em;
    font-weight: 500;
  }
  .nav-cta:hover { background: var(--ink) !important; }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    padding: 10px;
    margin-right: -10px;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--fg);
    transition: background 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }
  .nav.nav--dark .nav-toggle span { background: var(--cream); }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 640px) {
    .nav-toggle { display: inline-flex; }
    .nav-links {
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--hairline);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.28s ease;
    }
    .nav.nav--dark .nav-links { background: var(--espresso); }
    .nav-links.open { max-height: 420px; }
    .nav-links a:not(.nav-cta) {
      display: block;
      padding: 17px clamp(20px, 5vw, 64px);
      border-bottom: 1px solid var(--hairline);
      font-size: 0.98rem;
    }
    .nav.nav--dark .nav-links a:not(.nav-cta) { border-bottom-color: var(--line-light); }
    .nav-links .nav-cta {
      display: flex;
      margin: 18px clamp(20px, 5vw, 64px);
      justify-content: center;
      text-align: center;
    }
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(64px, 11vh, 110px);
  }
  #vein-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .hero-carousel {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    background-image: var(--slide-img);
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.8s ease;
  }
  .hero-slide.is-active { opacity: 1; }
  /* Na širim (laptop/desktop) ekranima izvorne fotografije su portretne, pa "cover"
     odreze prevelik dio slike. Od 900px širine prikazujemo cijelu fotografiju
     (background-size: contain) preko zamucenog "backdrop" sloja iste slike. */
  @media (min-width: 900px) {
    .hero-slide { background-image: none; }
    .hero-slide::before,
    .hero-slide::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--slide-img);
      background-repeat: no-repeat;
      background-position: center;
    }
    .hero-slide::before {
      background-size: cover;
      filter: blur(44px) brightness(0.5) saturate(1.15);
      transform: scale(1.15);
    }
    .hero-slide::after {
      background-size: contain;
    }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(100deg, rgba(18,14,10,0.78) 0%, rgba(18,14,10,0.58) 32%, rgba(18,14,10,0.28) 58%, rgba(18,14,10,0.08) 78%),
      linear-gradient(0deg, rgba(18,14,10,0.32) 0%, rgba(18,14,10,0.05) 40%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(90px, 14vh, 150px);
    color: var(--cream);
  }
  .hero .eyebrow { color: var(--terra-soft); display: block; margin-bottom: 22px; }
  .hero h1 {
    font-size: clamp(1.7rem, 3.8vw, 2.7rem);
    max-width: 30ch;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: var(--cream);
  }
  .hero h1 span { color: var(--terra-soft); }
  .hero-sub {
    margin-top: 26px;
    max-width: 46ch;
    font-size: 1.08rem;
    color: var(--cream-muted);
  }
  .hero .btn-ghost {
    border-color: rgba(246,241,228,0.4);
    color: var(--cream);
  }
  .hero .btn-ghost:hover { border-color: var(--terra-soft); color: var(--terra-soft); }
  .hero-actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  @media (max-width: 480px) {
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { justify-content: center; }
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 999px;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    font-weight: 500;
    border: 1px solid transparent;
    cursor: pointer;
    transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-solid {
    background: #17150f;
    color: #faf6ec;
  }
  .btn-solid:hover { background: var(--ink); }
  .btn-ghost {
    border-color: rgba(50,47,40,0.3);
    color: var(--ink);
  }
  .btn-ghost:hover { border-color: var(--terra-2); color: var(--terra-2); }
  .contact .btn-ghost {
    border-color: rgba(246,241,228,0.35);
    color: var(--cream);
  }
  .contact .btn-ghost:hover { border-color: var(--terra-soft); color: var(--terra-soft); }

  /* ---------- SECTION GENERIC ---------- */
  section { padding: clamp(64px, 11vw, 128px) 0; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 56px;
  }
  .section-head h2 { font-size: clamp(1.9rem, 3.2vw, 2.5rem); max-width: 20ch; font-weight: 600; }
  .section-head .section-note {
    max-width: 32ch;
    font-size: 0.95rem;
    color: var(--fg-muted);
    text-align: right;
  }
  @media (max-width: 720px) {
    .section-head { flex-direction: column; align-items: flex-start; }
    .section-head .section-note { text-align: left; }
  }

  /* ---------- INTRO ---------- */
  .intro { background: var(--veins-svg) center/cover no-repeat, var(--bg); }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .intro-grid .lede {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    color: var(--ink);
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
  }
  .intro-grid p { font-size: 1.02rem; color: var(--fg-muted); margin: 0 0 16px; }
  .intro-grid p:last-child { margin-bottom: 0; }
  @media (max-width: 800px) {
    .intro-grid { grid-template-columns: 1fr; }
  }

  /* ---------- SERVICES (card style) ---------- */
  .services { background: var(--veins-svg) center/cover no-repeat, var(--bg-deep); }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    background: var(--bg-raise);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card-media {
    aspect-ratio: 4 / 3;
    width: 100%;
    position: relative;
    overflow: hidden;
  }
  .card-body { padding: 28px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .card-body h3 { font-size: 1.25rem; font-weight: 600; }
  .card-body p { margin: 0; color: var(--fg-muted); font-size: 0.95rem; flex: 1; }
  .card-tags {
    display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px;
  }
  .card-tags span {
    font-family: "Work Sans", sans-serif;
    font-weight: 600;
    font-size: 0.7rem;
    color: var(--fg-muted);
    background: var(--bg-deep);
    padding: 5px 10px;
    border-radius: 999px;
  }
  @media (max-width: 900px) {
    .card-grid { grid-template-columns: 1fr; }
  }
  .card-grid--single {
    grid-template-columns: minmax(280px, 480px);
    justify-content: center;
  }

  /* ---------- GALERIJA: photo folders ---------- */
  .folder-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .folder-tile { cursor: pointer; }
  .folder-tile--empty { cursor: default; }
  .folder-cover {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
  }
  .folder-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .folder-tile:hover .folder-cover img { transform: scale(1.04); }
  .folder-cover--placeholder {
    border: 1px dashed var(--hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-muted);
    font-family: "Work Sans", sans-serif;
    font-weight: 600;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
  }
  .folder-label {
    margin-top: 12px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .folder-name { font-family: "Bodoni Moda", Georgia, serif; font-weight: 600; font-size: 1.05rem; }
  .folder-count {
    font-family: "Work Sans", sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .folder-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .folder-grid { grid-template-columns: 1fr; }
  }


  /* ---------- ZAVRŠENI PROJEKTI (accordion within Galerija) ---------- */
  .folder-tile--link { display: block; text-decoration: none; color: inherit; }
  .zavrseni-projekti { margin-top: 56px; }
  .zp-accordion-wrap[hidden] { display: none !important; }
  .zp-accordion-wrap { margin-top: 24px; }
  .zp-accordion { display: flex; flex-direction: column; }
  .zp-category { border-bottom: 1px solid var(--hairline); }
  /* ---------- Zavrseni projekti: vodoravna traka svih vrsta kamena ---------- */
  .zp-strip-wrap { display: flex; align-items: center; gap: 12px; margin: 4px 0 40px; }
  .zp-strip {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px 2px 12px;
    flex: 1 1 auto;
  }
  .zp-strip::-webkit-scrollbar { display: none; }
  .zp-strip-tile {
    flex: 0 0 auto;
    width: 128px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }
  .zp-strip-cover {
    width: 128px;
    height: 168px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 22px rgba(30,26,18,0.16);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .zp-strip-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .zp-strip-tile:hover .zp-strip-cover {
    transform: scale(1.1);
    box-shadow: 0 16px 30px rgba(30,26,18,0.24);
  }
  .zp-strip-name {
    margin-top: 10px;
    font-family: "Bodoni Moda", Georgia, serif;
    font-weight: 600;
    font-size: 0.84rem;
    text-align: center;
    color: var(--fg);
    line-height: 1.25;
  }
  .zp-strip-arrow {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: var(--bg-raise);
    color: var(--fg);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }
  .zp-strip-arrow:hover { background: var(--bg-deep); border-color: var(--accent); }
  .zp-strip-arrow:active { transform: scale(0.92); }
  .zp-strip-arrow svg { width: 18px; height: 18px; }
  @media (max-width: 640px) {
    .zp-strip-tile, .zp-strip-cover { width: 104px; }
    .zp-strip-cover { height: 136px; }
  }
  .zp-subcategory { border-bottom: 1px solid var(--hairline); }
  .zp-subcategory:last-child { border-bottom: none; }
  .zp-category > summary,
  .zp-subcategory > summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 2px;
  }
  .zp-category > summary::-webkit-details-marker,
  .zp-subcategory > summary::-webkit-details-marker { display: none; }
  .zp-name { font-family: "Bodoni Moda", Georgia, serif; font-weight: 600; font-size: 1.05rem; }
  .zp-subcategory .zp-name { font-size: 0.94rem; font-weight: 500; }
  .zp-count {
    font-family: "Work Sans", sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--fg-muted);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .zp-category > summary::after,
  .zp-subcategory > summary::after {
    content: "+";
    font-family: "Work Sans", sans-serif;
    font-weight: 600;
    color: var(--fg-muted);
    font-size: 1rem;
  }
  .zp-category[open] > summary::after,
  .zp-subcategory[open] > summary::after { content: "\2212"; }
  .zp-grid { margin: 4px 0 32px; grid-template-columns: repeat(4, 1fr); }
  .zp-subaccordion { padding-left: 24px; }
  @media (max-width: 900px) {
    .zp-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .zp-grid { grid-template-columns: 1fr; }
    .zp-subaccordion { padding-left: 12px; }
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(10,9,7,0.94);
    align-items: center;
    justify-content: center;
  }
  .lightbox.open { display: flex; }
  .lightbox-img {
    max-width: 88vw;
    max-height: 84vh;
    object-fit: contain;
    border-radius: 6px;
